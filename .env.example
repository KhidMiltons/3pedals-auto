# Server port (AI Studio uses port 3000)
PORT=3000

# Gemini API & Google Maps Platform keys (injected in Settings > Secrets)
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=

# Optional Google Search Console script variables (.mjs scripts only)
GSC_PROPERTY_URL=https://3pedalsauto.co.ke/
GSC_SERVICE_ACCOUNT_JSON=
